# Supabase (backend for the enquiry form at /services#contact).
# These are public/publishable values — safe to expose to the browser —
# because the "enquiries" table's RLS policy only allows INSERT from
# this key, never SELECT/UPDATE/DELETE.
NEXT_PUBLIC_SUPABASE_URL=https://fduicakjkwrwkquyggpx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1Hf9QItZ6lP821co4j4BcA_t36rhcth

# Email delivery is handled entirely on the Supabase side: a database
# trigger on "enquiries" calls the "notify-enquiry" Edge Function on
# every insert, which emails the agency inbox and the enquirer via
# Resend. Nothing to configure here in the Next.js app for that —
# set RESEND_API_KEY as an Edge Function secret in the Supabase
# dashboard instead (Project Settings -> Edge Functions -> Secrets).
